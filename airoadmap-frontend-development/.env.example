# Copy this file to .env.local and fill in values.
# Never put real keys in this file. Never commit .env.local.

# Kanak — Groq (https://console.groq.com/keys)
GROQ_API_KEY=
# llama-3.1-8b-instant was shut down on Groq free/dev (2026-08-16)
GROQ_MODEL=openai/gpt-oss-20b

# Sanvi — PostgreSQL (Neon or Supabase)
# If the password contains @ # or /, URL-encode it (e.g. @ → %40)
DATABASE_URL=

# Reshal — resource discovery
YOUTUBE_API_KEY=
GITHUB_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Frontend deployment
# Set this to your Render backend base URL, for example:
# https://your-render-service.onrender.com/api
NEXT_PUBLIC_API_URL=https://ai-roadmap-20z8.onrender.com/
